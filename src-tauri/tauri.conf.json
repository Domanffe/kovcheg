{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kovcheg",
  "version": "2.0.0",
  "identifier": "app.kovcheg.desktop",
  "build": {
    "frontendDist": "../dist/gui",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node scripts/dev-before.mjs",
    "beforeBuildCommand": "npm run build:gui && npm run build:sidecar && npm run build:sidecar:bin"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kovcheg",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* https://cdn.jsdelivr.net https://raw.githubusercontent.com https://github.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/search-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://cdn.jsdelivr.net/gh/Domanffe/kovcheg@main/updater/latest.json",
        "https://raw.githubusercontent.com/Domanffe/kovcheg/main/updater/latest.json",
        "https://github.com/Domanffe/kovcheg/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGMTZFQkNBNjU3Njg0MkEKUldRcWhIWmx5dXNXSDR3KzBGRWZpcDVUby84bHZSS1JYL3hZaTBUTCt2SzM4UUh1ZUlQWnpZSXUK"
    }
  }
}
